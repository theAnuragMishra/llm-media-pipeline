# Media Pipeline Environment Configuration

# Service Settings
APP_NAME=CourseVideoPipeline
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Broker Settings (rabbitmq | memory)
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=video.generate.jobs
RABBITMQ_EXCHANGE=media.pipeline.exchange
RABBITMQ_ROUTING_KEY=video.generate
RABBITMQ_PREFETCH_COUNT=1

# Redis Settings (for pub/sub & task state caching)
REDIS_URL=redis://localhost:6379/0

# Storage Settings (local | s3)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage

# LLM Provider (openai | gemini) - API KEY REQUIRED
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Custom Base URL (optional for Groq, DeepSeek, Together, or local Ollama)
LLM_BASE_URL=

# TTS Provider (edge_tts | openai)
# edge_tts is free, high quality neural voice (no API key required)
# openai uses OpenAI Audio API (requires OPENAI_API_KEY)
TTS_PROVIDER=edge_tts
TTS_VOICE=en-US-ChristopherNeural
